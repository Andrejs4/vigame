# Vigame game server, run by systemd. deploy/install.sh puts this in
# /etc/systemd/system/vigame.service; see deploy/README.md.
#
# Layout:
#   /opt/vigame/node     Node.js, for this service only
#   /opt/vigame/app      the game, as installed (read-only to the service)
#   /var/lib/vigame      the database (StateDirectory below)
#   /etc/vigame/vigame.env  settings: PORT, MONITOR_PASSWORD, ...

[Unit]
Description=Vigame game server
After=network.target

[Service]
Type=simple
User=vigame
Group=vigame
WorkingDirectory=/opt/vigame/app
ExecStart=/opt/vigame/node/bin/node server/main.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=2567
Environment=VIGAME_DB=/var/lib/vigame/vigame.db
# Your own settings override the ones above. The leading "-" means the
# file may be missing.
EnvironmentFile=-/etc/vigame/vigame.env

# The server saves every game when it gets SIGTERM; give it time.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# /var/lib/vigame, owned by the service user, is the only place it can write.
StateDirectory=vigame
StateDirectoryMode=0750
UMask=0027

# Sandboxing: the process sees the system read-only, no home directories,
# no devices, and gets no privileges. (No MemoryDenyWriteExecute: Node's
# JIT needs it.)
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
