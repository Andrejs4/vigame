  "description": "Turn-based hex strategy prototype: canvas board, hotseat play, online play through a Colyseus game server or the claude.ai Artifact runtime.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
